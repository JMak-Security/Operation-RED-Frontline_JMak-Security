# =============================================================================
# ORF v4.0.0 — red-team configuration TEMPLATE
# Copy this file to `.env` (or `PLACEHOLDER.env`, which main.py loads) and fill
# in your own values. `.env`/`PLACEHOLDER.env` are git-ignored; this template is
# safe to commit. NEVER commit real keys.
# =============================================================================

# --- NAMED OPENAI-COMPATIBLE PROVIDERS ---------------------------------------
# Pick one with --provider / --attacker-provider / --target-provider /
# --judge-provider and ORF auto-fills endpoint + key + default model from the
# NAME_* vars below. Every provider is transported as OpenAI-compatible.
#   python main.py chat --provider groq -m "hello"
#   python main.py run  --suite quick --attacker-provider featherless \
#        --judge-provider deepinfra --target-provider sse
# Override a provider's model per run with --model / --secondary-model / --judge-model.
#
# Names: nvidia | google | groq | openrouter | siliconflow | cloudflare |
#        featherless | deepinfra | together | deepseek | mistral | fireworks |
#        perplexity | xai | cerebras | novita | hyperbolic | ollamacloud | custom

# NVIDIA            (https://integrate.api.nvidia.com/v1)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Google AI Studio  (OpenAI surface at /v1beta/openai)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-flash-lite-latest
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Groq              (https://api.groq.com/openai/v1)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenRouter        (https://openrouter.ai/api/v1)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# SiliconFlow       (https://api.siliconflow.com/v1)
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1

# Cloudflare Workers AI (account id is part of the base URL)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1

# Featherless AI    (https://api.featherless.ai/v1)
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# DeepInfra         (https://api.deepinfra.com/v1/openai)
DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

# Together AI       (https://api.together.xyz/v1)
TOGETHER_API_KEY=
TOGETHER_MODEL=
TOGETHER_BASE_URL=https://api.together.xyz/v1

# DeepSeek          (https://api.deepseek.com/v1)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Mistral           (https://api.mistral.ai/v1)
MISTRAL_API_KEY=
MISTRAL_MODEL=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Fireworks AI      (https://api.fireworks.ai/inference/v1)
FIREWORKS_API_KEY=
FIREWORKS_MODEL=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Perplexity        (https://api.perplexity.ai)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=
PERPLEXITY_BASE_URL=https://api.perplexity.ai

# xAI / Grok        (https://api.x.ai/v1)
XAI_API_KEY=
XAI_MODEL=
XAI_BASE_URL=https://api.x.ai/v1

# Cerebras          (https://api.cerebras.ai/v1)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Novita AI         (https://api.novita.ai/v3/openai)
NOVITA_API_KEY=
NOVITA_MODEL=
NOVITA_BASE_URL=https://api.novita.ai/v3/openai

# Hyperbolic        (https://api.hyperbolic.xyz/v1)
HYPERBOLIC_API_KEY=
HYPERBOLIC_MODEL=
HYPERBOLIC_BASE_URL=https://api.hyperbolic.xyz/v1

# Ollama Cloud      (https://ollama.com/v1)
OLLAMACLOUD_API_KEY=
OLLAMACLOUD_MODEL=
OLLAMACLOUD_BASE_URL=https://ollama.com/v1

# Custom / self-hosted OpenAI-compatible endpoint. CUSTOM_BASE_URL is REQUIRED.
CUSTOM_API_KEY=
CUSTOM_MODEL=
CUSTOM_BASE_URL=

# --- ROLES -------------------------------------------------------------------
# Default roles WITHOUT flags: a bare `python main.py run` uses ATTACKER_PROVIDER
# to generate payloads and JUDGE_PROVIDER to decide verdicts.
ATTACKER_PROVIDER=ollama
JUDGE_PROVIDER=ollama
LLM_PROVIDER=ollama

# --- LOCAL OLLAMA (attacker/judge) -------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PRIMARY_MODEL=dolphin-llama3
OLLAMA_SECONDARY_MODEL=ChatTarget
OLLAMA_MAX_CONCURRENT_TASKS=1

# --- TARGET (system under test) ----------------------------------------------
# sse = generic SSE chatbot | openai = OpenAI-compatible /v1 | ollama = native
TARGET_PROVIDER=sse
TARGET_BASE_URL=https://your-chat-host.example
TARGET_API_KEY=
TARGET_COOKIE=
TARGET_FILE_UPLOAD_URL=https://your-chat-host.example/api/file/upload?type=chat
TARGET_INDIRECT_MODE=direct
TARGET_FILE_ATTACH_MODE=body_field
TARGET_FILE_ATTACH_FIELD=file_ids
TARGET_OBFUSCATION=all
TARGET_OBFUSCATION_COMBINE=false

# --- SAMPLING (OpenAI-compatible endpoints) ----------------------------------
# Leave blank to omit the field for stricter backends.
OPENAI_TEMPERATURE=0.0
OPENAI_REPETITION_PENALTY=1.2

# --- JUDGE -------------------------------------------------------------------
JUDGE_FEWSHOT=true
JUDGE_SAMPLES=3
JUDGE_TEMPERATURE=0.3

# --- COMPOSITION / ADVANCED TECHNIQUES ---------------------------------------
ORF_COMPOSE_MODE=off
ORF_INJECTION_TECHNIQUES=
ORF_AGENTIC_INTEL=false
ORF_EXFIL_HOST=collector.redteam-lab.example

# --- SUPERDATA EXTRACTOR (optional pre-generation intel) ---------------------
ORF_SUPERDATA_SOURCE=
ORF_SUPERDATA_URL=
ORF_SUPERDATA_REFRESH=false

# --- TEST MEMORY (persistent self-learning) ----------------------------------
# off | record | learn
ORF_MEMORY_MODE=learn

# --- RUNTIME ENVIRONMENT (Docker / VPN) --------------------------------------
# off | on | auto
ORF_DOCKER_MODE=off
ORF_VPN_MODE=off

# --- PQC (liboqs) ------------------------------------------------------------
# The native liboqs auto-build is skipped automatically when no C toolchain
# (git+cmake) and no prebuilt liboqs are present. Set to 1 to force-disable PQC.
ORF_DISABLE_PQC=

# --- OPTIONAL: GitHub issue sync ---------------------------------------------
GITHUB_ACCESS_TOKEN=
GITHUB_TARGET_REPOSITORY=your-org/your-repo

# --- OPTIONAL: telemetry DB --------------------------------------------------
DATABASE_URL=sqlite:///:memory:
